{
  "include": ["backend"],
  "exclude": ["**/node_modules", "**/__pycache__"],
  "venvPath": "backend",
  "venv": ".venv",
  "extraPaths": [
    "backend",
    "backend/app"
  ],
  "pythonVersion": "3.10",
  "typeCheckingMode": "basic",
  "reportMissingImports": true,
  "reportMissingTypeStubs": false
}
