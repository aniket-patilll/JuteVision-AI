# Sensitive Information
.env

# Dependencies & System Junk (Recommended to keep ignored)
node_modules/
__pycache__/
.venv/
venv/
env/
.DS_Store
.git

# Data & Output (Ignored contents, but track folders via .gitkeep)
backend/data/uploads/*
!backend/data/uploads/.gitkeep

backend/data/detections/*
!backend/data/detections/.gitkeep

# State & Logs (Ignored)
backend/data/*.json

# Shared Media
*.mp4
!frontend/assets/samples/*.mp4

# Note: AI Models (.pt), Training Data, and Scripts are tracked.
